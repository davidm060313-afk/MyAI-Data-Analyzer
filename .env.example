# Copy this file to .env and fill in the values.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
# Existing MyAI endpoint: use the exact URL for the JSON API route, not just the homepage.
# For the MySpace project this may be https://YOUR-MYSPACE-SITE/api/ai
MYAI_API_URL=
MYAI_API_TOKEN=
# Optional direct Gemini fallback if MyAI URL is not set or fails
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Local SQLite by default. For cloud hosting set DATABASE_URL to your PostgreSQL connection string.
DATABASE_URL=
DATA_DIR=data
MAX_UPLOAD_MB=100
# Optional transcription model: tiny, base, small
WHISPER_MODEL=base
